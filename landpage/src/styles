@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap');

/* ===== RESET ===== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Outfit", sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f5f5;
    color: #333;
    overflow-x: hidden;
}


/* ===== HEADER ===== */

header {
    width: 100%;
    padding: 20px 8%;
}

#navbar {
    display: flex;
    align-items: center;
    gap: 30px;
}

#nav_logo {
    width: 120px;
}

#nav_list {
    display: flex;
    gap: 40px;
    list-style: none;
    margin-left: auto;
}

.nav-item a {
    position: relative;
    color: #200144;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    transition: .3s;
}

.nav-item a:hover {
    color: #8B5CF6;
}

.nav-item.active a {
    color: #38045e;
}

.nav-item.active a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 100%;
    height: 3px;
    background: #38045e;
    border-radius: 10px;
}


/* ===== BOTÕES ===== */

.btn-default {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 105px;
    padding: 12px 20px;
    border: none;
    border-radius: 12px;
    background: #8B5CF6;
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
    transition: .3s;
}

.btn-default:hover {
    background: #7C3AED;
    transform: translateY(-2px);
}

.nav-button {
    margin-left: 10px;
}


/* ===== MENU MOBILE ===== */

#mobile_menu {
    display: none;
    margin-left: auto;
    border: none;
    background: transparent;
    color: #200144;
    font-size: 24px;
    cursor: pointer;
}


/* ===== HOME ===== */

#home {
    position: relative;
    min-height: calc(100vh - 81px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    padding: 60px 8%;
    overflow: hidden;
}

#cta {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    z-index: 2;
}

.section-subtitle {
    color: #8B5CF6;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.title {
    max-width: 650px;
    color: #200144;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
}

.title span,
.section-title span {
    color: #8B5CF6;
}

.description,
.section-description {
    max-width: 620px;
    color: #555;
    font-size: 17px;
    line-height: 1.7;
}

#cta_buttons {
    display: flex;
    gap: 16px;
    margin-top: 10px;
}


/* ===== IMAGEM ===== */

#banner {
    width: 50%;
    display: flex;
    justify-content: center;
    z-index: 2;
}

#banner img {
    width: 100%;
    max-width: 600px;
    height: auto;
}


/* Forma decorativa */

.shape {
    position: absolute;
    width: 500px;
    height: 500px;
    right: -200px;
    top: 50%;
    transform: translateY(-50%);
    background: #ede9fe;
    border-radius: 50%;
}


/* ===== SEÇÕES ===== */

#metodologia,
#contato {
    padding: 100px 8%;
}

#metodologia {
    background: white;
}

.section-content {
    max-width: 1200px;
    margin: auto;
    display: flex;
    align-items: center;
    gap: 70px;
}

.section-text {
    flex: 1;
}

.section-title {
    max-width: 600px;
    margin: 12px 0 24px;
    color: #200144;
    font-size: 2.8rem;
    line-height: 1.15;
}


/* ===== CARDS ===== */

.methodology-cards {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.methodology-card {
    padding: 28px;
    background: #f8f7ff;
    border: 1px solid #eee9ff;
    border-radius: 18px;
    transition: .3s;
}

.methodology-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 30px rgba(56, 4, 94, .1);
}

.methodology-icon {
    margin-bottom: 15px;
    color: #8B5CF6;
    font-size: 28px;
}

.methodology-card h3 {
    margin-bottom: 10px;
    color: #200144;
}

.methodology-card p {
    color: #666;
    font-size: 15px;
    line-height: 1.6;
}


/* ===== CONTATO ===== */

#contato {
    text-align: center;
}

.contact-content {
    max-width: 850px;
    margin: auto;
}

#contato .section-title,
#contato .section-description {
    margin-left: auto;
    margin-right: auto;
}

.contact-options {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 35px;
}

.contact-item {
    min-width: 220px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: white;
    border-radius: 15px;
    text-decoration: none;
    text-align: left;
    box-shadow: 0 4px 15px rgba(0, 0, 0, .06);
    transition: .3s;
}

.contact-item:hover {
    transform: translateY(-4px);
}

.contact-item > i {
    color: #8B5CF6;
    font-size: 25px;
}

.contact-item h3 {
    color: #200144;
    margin-bottom: 4px;
}

.contact-item p {
    color: #666;
    font-size: 14px;
}


/* ===== TABLET ===== */

@media screen and (max-width: 1170px) {

    #nav_list,
    .nav-button {
        display: none;
    }

    #mobile_menu {
        display: block;
    }

    #home {
        gap: 40px;
    }
}


/* ===== TABLET / CELULAR ===== */

@media screen and (max-width: 900px) {

    #home {
        flex-direction: column;
        text-align: center;
        padding: 70px 8%;
    }

    #cta,
    #banner {
        width: 100%;
        align-items: center;
    }

    #cta {
        align-items: center;
    }

    #banner img {
        max-width: 500px;
    }

    .section-content {
        flex-direction: column;
        gap: 50px;
    }
}


/* ===== CELULAR ===== */

@media screen and (max-width: 600px) {

    header {
        padding: 18px 6%;
    }

    #nav_logo {
        width: 100px;
    }

    #home {
        padding: 50px 6% 70px;
    }

    .title {
        font-size: 2.3rem;
    }

    .description,
    .section-description {
        font-size: 16px;
    }

    #cta_buttons {
        justify-content: center;
    }

    #metodologia,
    #contato {
        padding: 70px 6%;
    }

    .section-title {
        font-size: 2.2rem;
    }

    .methodology-cards {
        grid-template-columns: 1fr;
    }

    .contact-options {
        flex-direction: column;
        align-items: center;
    }

    .contact-item {
        width: 100%;
        max-width: 380px;
    }

    .shape {
        width: 300px;
        height: 300px;
        right: -150px;
    }
}


/* ===== CELULAR PEQUENO ===== */

@media screen and (max-width: 480px) {

    .title {
        font-size: 2rem;
    }

    #cta_buttons {
        flex-direction: column;
        width: 100%;
    }

    #cta_buttons .btn-default {
        width: 100%;
    }
}